# local.env: this machine's and this car's private settings. Copy to local.env (gitignored) and
# fill in. Never commit local.env: this repository is public. The tools source it if present.

# The car's SSH connection (CoilShift's sshd, over Tailscale), for the skill's check scripts.
CAR_SSH="-p 13400 root@<car host>"

# The owner phone's public key (130 hex, uncompressed P-256), for gateway/deploy/signin_precheck.sh:
#   ssh $CAR_SSH "PHONE=$PHONE sh -s" < gateway/deploy/signin_precheck.sh
PHONE=

# Firmware dumps for tools/build.sh's rule tests (default: ../tesla-dump next to this repo).
#FW_DUMP=/path/to/tesla-dump

# Extended regex of identifiers that must never be published or committed (tools/leakscan.sh,
# tools/publish.sh, direct-link/build-payloads.sh): the VIN and fragments of it (prefix,
# serial), the tailnet name, the phone key's first/last hex and its key id and fingerprint,
# MAC addresses. Case-insensitive.
LEAK_PATTERN='<vin prefix>|<vin serial>|<tailnet name>|<phone key head>|<phone key tail>'
