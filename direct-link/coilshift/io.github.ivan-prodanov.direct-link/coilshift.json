{
  "schema": 1,
  "id": "io.github.ivan-prodanov.direct-link",
  "version": "1.2.4",
  "sdk": ">=1.0 <2",
  "title": "Direct Link",
  "summary": "Live camera, talk through the car's speaker, dashcam clips and your phone's car commands, straight from the car over your own Tailscale. Pair by scanning the QR in its panel. Needs the companion app and CoilShift's Tailscale. Runs runit and an iptables chain.",
  "capabilities": [
    "service",
    "image.mount",
    "bind",
    "panel"
  ],
  "panel": {
    "entry": "panel/index.html",
    "title": "Direct Link",
    "permissions": [
      "data",
      "status"
    ]
  },
  "payloads": [
    {
      "path": "payload/direct-link-3a288f7.sqfs",
      "sha256": "e602b8faf7b4e961986a4c2f16125296bc2141edc4463893f17a1d7a46d084dc",
      "size": 9986048
    }
  ],
  "hooks": {
    "apply": [
      {
        "id": "apply",
        "run": "hooks/apply.sh",
        "rerun": "in-place",
        "phase": "late",
        "timeout": 300
      }
    ],
    "service": [
      {
        "id": "supervise",
        "run": "bin/supervise.sh",
        "restart": "always"
      }
    ],
    "remove": {
      "run": "hooks/remove.sh",
      "timeout": 120
    }
  }
}
