{
  "schema": 1,
  "id": "io.github.ivan-prodanov.direct-link",
  "version": "1.1.1",
  "sdk": ">=1.0 <2",
  "title": "Direct Link",
  "summary": "Live camera, talk through the car's speaker and dashcam clips on your phone, straight from the car over your own Tailscale. Pair by scanning the QR in its panel. Needs the companion app and CoilShift's Tailscale. Runs runit and an iptables chain: the gateway only answers.",
  "capabilities": [
    "service",
    "image.mount",
    "bind",
    "panel"
  ],
  "panel": {
    "entry": "panel/index.html",
    "title": "Direct Link",
    "permissions": ["data", "status"]
  },
  "payloads": [
    {
      "path": "payload/direct-link-80b14ad.sqfs",
      "sha256": "9a1e9663dacf2636388e453f9c3afabc1567c9b3015d1ad242de39c7b8f95b6b",
      "size": 9920512
    }
  ],
  "hooks": {
    "apply": [
      {
        "id": "apply",
        "run": "hooks/apply.sh",
        "rerun": "in-place",
        "phase": "late",
        "timeout": 300
      }
    ],
    "service": [
      {
        "id": "supervise",
        "run": "bin/supervise.sh",
        "restart": "always"
      }
    ],
    "remove": {
      "run": "hooks/remove.sh",
      "timeout": 120
    }
  }
}
