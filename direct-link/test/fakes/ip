#!/bin/bash
# fake ip: `ip -4 -o addr show dev IFACE` prints .fakes/state/ip.<IFACE> (empty: no address).
. "$(dirname "$0")/_lib.sh"
log "ip $*"
[ "$1 $2 $3 $4 $5" = "-4 -o addr show dev" ] || { echo "fake ip: unsupported $*" >&2; exit 2; }
[ -f "$st/ip.$6" ] || { echo "Device \"$6\" does not exist." >&2; exit 1; }
cat "$st/ip.$6"
